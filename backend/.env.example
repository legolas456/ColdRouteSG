APP_NAME=ColdRoute SG API
ALLOW_MOCK_FALLBACK=true
REQUEST_TIMEOUT_SECONDS=12
CORS_ORIGINS=http://localhost:5173

# Live road speeds (LTA DataMall Traffic Speed Bands). Free sign-up:
# https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=
# Optional: read the grid that traffic_refresh.py publishes to S3 instead of calling LTA.
TRAFFIC_BUCKET=
TRAFFIC_KEY=traffic/speed-grid.json

# Route history (DynamoDB) and the admin dashboard's user list (Cognito). Leave
# empty to run without them; `terraform -chdir=infra output` prints both.
DYNAMODB_ROUTES_TABLE=
AWS_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
