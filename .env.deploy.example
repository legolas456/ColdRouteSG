# Settings for scripts/deploy-frontend.sh (make deploy).
# Copy to .env.deploy.local, which git ignores. No AWS keys here: they live in
# ~/.aws/credentials under the profile named below. See docs/deployment.md.
AWS_PROFILE=coldroute
AWS_REGION=ap-southeast-1
AMPLIFY_APP_NAME=coldroute-sg
AMPLIFY_BRANCH=main
# Filled in by the first deploy:
AMPLIFY_APP_ID=
